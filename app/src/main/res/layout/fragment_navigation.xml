<?xml version="1.0" encoding="utf-8"?>

<!-- Пояснение: Горизонтальная нижняя панель меню отдельного фрагмента. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="#FFFFFFFF"
    android:elevation="8dp">

    <!-- Пояснение: Активный пункт меню, который соответствует открытой странице вакансий. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Пояснение: Значок активного пункта меню. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▣"
            android:textColor="#FF004CD2"
            android:textSize="18sp" />

        <!-- Пояснение: Подпись активного пункта меню. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vacancies"
            android:textColor="#FF004CD2"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Пояснение: Неактивный пункт кандидатов из макета задания. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Пояснение: Значок пункта кандидатов. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♧"
            android:textColor="#FF8994A9"
            android:textSize="18sp" />

        <!-- Пояснение: Подпись пункта кандидатов. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Candidates"
            android:textColor="#FF8994A9"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Пояснение: Неактивный пункт профиля из макета задания. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Пояснение: Значок пункта профиля. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♙"
            android:textColor="#FF8994A9"
            android:textSize="18sp" />

        <!-- Пояснение: Подпись пункта профиля. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="#FF8994A9"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
