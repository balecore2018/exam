<?xml version="1.0" encoding="utf-8"?>

<!-- Пояснение: Прямоугольный фон поля поиска со светлой заливкой и рамкой. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Пояснение: Задаём светлый цвет фона поля. -->
    <solid android:color="#FFF4F3FB" />

    <!-- Пояснение: Скругляем углы фона. -->
    <corners android:radius="8dp" />

    <!-- Пояснение: Рисуем тонкую серо-голубую границу. -->
    <stroke
        android:width="1dp"
        android:color="#FFD5D8E6" />
</shape>
