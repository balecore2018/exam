            </intent-filter> <!-- Пояснение: Завершаем фильтр запуска главного экрана. -->
        </activity> <!-- Пояснение: Завершаем объявление Activity приложения. -->
    </application> <!-- Пояснение: Завершаем описание приложения. -->
</manifest> <!-- Пояснение: Завершаем AndroidManifest. -->

