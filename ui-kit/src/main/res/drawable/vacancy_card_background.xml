<?xml version="1.0" encoding="utf-8"?>

<!-- Пояснение: Фон карточки вакансии с белой заливкой и мягкой рамкой. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" /> <!-- Пояснение: Окрашиваем поверхность карточки в белый. -->
    <corners android:radius="12dp" /> <!-- Пояснение: Скругляем углы карточки. -->
    <stroke android:width="1dp" android:color="#FFF0EFF5" /> <!-- Пояснение: Добавляем тонкий контур. -->
</shape>
